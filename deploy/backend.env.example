# Spring Boot 监听端口。
SERVER_PORT=8080
# 生产环境允许的前端来源。
CORS_ALLOWED_ORIGINS=https://your-public-host

# MySQL 连接参数。
DB_URL=jdbc:mysql://127.0.0.1:3306/ai_techskill_book?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace-with-application-user
DB_PASSWORD=replace-with-server-secret
DB_POOL_SIZE=10

# Redis 会话存储参数。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-server-secret
REDIS_DATABASE=0

# 登录会话参数。
SESSION_COOKIE_NAME=atk_session
SESSION_TTL=7d
SESSION_SECURE_COOKIE=true

# 私有对象存储参数。
STORAGE_ENABLED=false
STORAGE_ENDPOINT=https://your-object-storage-endpoint
STORAGE_ACCESS_KEY=replace-with-server-secret
STORAGE_SECRET_KEY=replace-with-server-secret
STORAGE_BUCKET=your-private-bucket
STORAGE_REGION=us-east-1
STORAGE_ENVIRONMENT=prod
STORAGE_PATH_STYLE=true
AVATAR_MAX_SIZE=5MB
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=6MB

# 文档正文迁移和异步索引。
DOCUMENT_MIGRATE_OBJECT_STORAGE_ON_STARTUP=false
INDEX_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=38.95.75.32:9092
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_DOCUMENT_INDEX_TOPIC=knowledge-document-index
KAFKA_DOCUMENT_INDEX_GROUP=ai-techskill-book-indexer

# Elasticsearch 仅由后端访问，不能发送到浏览器。
ELASTICSEARCH_URL=http://38.95.75.32:9200
ELASTICSEARCH_USERNAME=replace-with-elasticsearch-user
ELASTICSEARCH_PASSWORD=replace-with-server-secret
ELASTICSEARCH_INDEX=knowledge_documents
INDEX_EMBEDDING_ENABLED=false

# OpenAI 兼容 API；真实密钥只能从服务器环境或密钥链注入。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
