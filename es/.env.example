# Elasticsearch 超级用户密码，生产环境必须使用高强度随机值。
ELASTIC_PASSWORD=replace-with-a-strong-password

# Kibana 连接 Elasticsearch 的 service account token。
KIBANA_SERVICE_TOKEN=replace-with-a-kibana-service-token

# Kibana 已保存对象的持久化加密密钥，至少 32 个字符。
KIBANA_ENCRYPTION_KEY=replace-with-at-least-32-characters

# Kibana 报表功能的持久化加密密钥，至少 32 个字符。
KIBANA_REPORTING_KEY=replace-with-at-least-32-characters

# Kibana 会话和安全数据的持久化加密密钥，至少 32 个字符。
KIBANA_SECURITY_KEY=replace-with-at-least-32-characters
