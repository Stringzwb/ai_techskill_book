{"doc_type":"architecture","title":"企业级RAG知识库架构","slug":"enterprise-rag-architecture","summary":"介绍文档解析、分块、向量检索、重排和答案生成的完整链路。","content":"检索增强生成通过外部知识降低模型幻觉。典型流程包括数据采集、格式解析、语义分块、向量化、混合检索、候选重排、上下文拼装、答案生成和引用溯源。企业场景还需要权限过滤、增量索引、文档版本、召回评测、缓存、审计日志以及无答案检测。","category":"知识工程","subcategory":"RAG","tags":["RAG","向量检索","重排","知识库","引用溯源"],"technologies":["Elasticsearch","Embedding","Reranker","Object Storage"],"difficulty":"高级","language":"zh-CN","status":"published","featured":true,"open_source":false,"use_cases":["企业知识问答","内部文档检索","智能助手"],"risks":["越权检索","错误引用","知识过期"],"author":{"name":"陈澈","type":"architect"},"metrics":{"quality_score":9.6,"reading_minutes":22,"popularity":99,"token_estimate":5100},"architecture":{"ingestion_mode":"incremental","retrieval_mode":"hybrid","rerank_top_k":20,"answer_top_k":6},"published_at":"2026-03-18T09:30:00+08:00","updated_at":"2026-08-03T11:10:00+08:00","source":{"name":"企业架构案例","url":"https://example.com/enterprise-rag","verified":true},"metadata":{"version":"3.1","license":"proprietary-demo","region":"cn"},"related_topics":["Embedding","全文搜索","访问控制"]}
