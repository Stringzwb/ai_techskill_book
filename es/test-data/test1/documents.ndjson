{"doc_type":"architecture","title":"生成式AI的MLOps流水线","slug":"generative-ai-mlops-pipeline","summary":"覆盖数据、训练、评测、发布、监控和回滚的模型生命周期。","content":"生成式AI的MLOps需要同时管理数据集、基础模型、适配器、提示词、评测集与运行配置。流水线应具备可复现构建、模型注册、审批门禁、灰度发布、在线观测和快速回滚。每次版本变化都要记录依赖、参数、数据血缘和安全评测结果，避免无法解释的线上漂移。","category":"AI工程","subcategory":"MLOps","tags":["MLOps","模型注册","CI/CD","数据血缘"],"technologies":["MLflow","Kubernetes","Git","Feature Store"],"difficulty":"高级","language":"zh-CN","status":"published","featured":true,"open_source":true,"use_cases":["模型发布","持续评测","版本回滚"],"risks":["版本不可追溯","训练服务偏差","错误模型上线"],"author":{"name":"AI平台组","type":"team"},"metrics":{"quality_score":9.5,"reading_minutes":23,"popularity":91,"token_estimate":5300},"pipeline":{"stages":["validate","train","evaluate","approve","deploy","monitor"],"rollback_minutes":5,"automated_tests":42,"approval_required":true},"published_at":"2026-06-08T16:00:00+08:00","updated_at":"2026-08-02T10:20:00+08:00","source":{"name":"平台工程规范","url":"https://example.com/genai-mlops","verified":true},"metadata":{"version":"2.7","license":"Apache-2.0","region":"global"},"related_topics":["模型监控","数据版本","灰度发布"]}
