{"doc_type":"operations","title":"大模型线上监控指标","slug":"llm-production-monitoring","summary":"整理延迟、错误、质量、成本和安全等生产监控指标。","content":"大模型服务应监控请求量、首Token延迟、生成速度、P95总延迟、超时率、错误率、上下文长度、输出长度和单次成本。质量侧可抽样评估事实性、相关性与拒答率，安全侧监控敏感内容和攻击特征。告警必须关联模型版本、提示词版本、租户和调用链。","category":"AI运维","subcategory":"可观测性","tags":["Monitoring","Tracing","Token成本","SLA"],"technologies":["OpenTelemetry","Prometheus","Grafana","Elasticsearch"],"difficulty":"中级","language":"zh-CN","status":"published","featured":false,"open_source":true,"use_cases":["生产监控","容量规划","成本治理"],"risks":["日志泄密","指标盲区","告警疲劳"],"author":{"name":"SRE团队","type":"team"},"metrics":{"quality_score":9.1,"reading_minutes":13,"popularity":88,"token_estimate":3000},"service_metrics":{"availability":0.9995,"p50_latency_ms":620,"p95_latency_ms":1800,"tokens_per_second":52.4,"error_rate":0.003},"published_at":"2026-06-12T12:00:00+08:00","updated_at":"2026-08-03T08:10:00+08:00","source":{"name":"SRE运行手册","url":"https://example.com/llm-monitoring","verified":true},"metadata":{"version":"1.9","license":"CC-BY-4.0","region":"global"},"related_topics":["容量规划","模型评测","成本优化"]}
